# Copy to .env and fill in. Never commit a real .env.
VITE_API_BASE_URL=http://localhost:5000

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. Public by design (RLS is the real control) —
# this is NOT the service_role key, which must never reach the browser.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin of this app. Used to build the magic-link redirect target
# (<site>/auth/callback) and must be listed in Supabase Auth -> URL Configuration.
VITE_PUBLIC_SITE_URL=http://localhost:5173
